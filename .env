# TripSplit World — build-time configuration
#
# Copy to `.env` (git-ignored) or export these as `--dart-define` flags.
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://<project-ref>.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=<publishable-anon-key>
#
# The values below are PLACEHOLDERS. Never commit real credentials.

# --- Supabase ---------------------------------------------------------------
# Project URL. Find it in Supabase > Project Settings > API.
SUPABASE_URL=https://qippwejcvhbikshpnndj.supabase.co

# The *publishable / anon* key only. Access is enforced by Row Level Security,
# so this key is safe to ship in a client bundle.
SUPABASE_ANON_KEY=sb_publishable_UToM7yzgKtxlytxi4W7guQ_QISYwbHY

# NEVER put SUPABASE_SERVICE_ROLE_KEY here. It belongs in Supabase Edge
# Function secrets only (supabase secrets set --env-file .env.functions).
# SUPABASE_SERVICE_ROLE_KEY=

# --- App behaviour ----------------------------------------------------------
APP_ENV=development        # development | staging | production
DEMO_MODE=false            # true runs fully offline on bundled fictional data

# --- Maps (OpenStreetMap by default; no key required) -----------------------
# For production volume, self-host tiles or use a commercial provider.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Required by the OSM tile usage policy: identify your app.
MAP_USER_AGENT=com.tripsplitworld.app

# --- Support ----------------------------------------------------------------
SUPPORT_EMAIL=support@tripsplitworld.example

# --- Edge Function secrets (server-side only, NOT --dart-define) -------------
# Set these with `supabase secrets set KEY=value`. They are documented here so
# you know what to configure; they must never reach the Flutter bundle.
#
# EXCHANGE_RATE_API_KEY=        # optional: exchangerate.host / Fixer.io / etc.
# EXCHANGE_RATE_PROVIDER=       # e.g. frankfurter | fixer | openexchangerates
# AI_PROVIDER=                  # openai | anthropic | gemini
# AI_API_KEY=
# AI_MODEL=
# RESEND_API_KEY=               # transactional email
# EMAIL_FROM=                   # verified sender domain
